{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:edht:device-configuration-evidence:1",
  "title": "Documented device configuration evidence; not a programming command",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "tenant_id", "patient_id", "device_id", "version", "previous_record_id", "effective_at", "recorded_at", "event", "source", "review", "settings"],
  "properties": {
    "record_id": {"type":"string","minLength":1},
    "tenant_id": {"type":"string","minLength":1},
    "patient_id": {"type":"string","minLength":1},
    "device_id": {"type":"string","minLength":1},
    "version": {"type":"integer","minimum":1},
    "previous_record_id": {"type":["string","null"],"minLength":1},
    "effective_at": {"type":"string","format":"date-time"},
    "recorded_at": {"type":"string","format":"date-time"},
    "event": {"enum":["IMPLANT","CONFIGURATION","REVISION","REPLACEMENT","EXPLANT"]},
    "source": {
      "type":"object","additionalProperties":false,
      "required":["record_id","version","sha256","author_id"],
      "properties":{
        "record_id":{"type":"string","minLength":1},
        "version":{"type":"string","minLength":1},
        "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "author_id":{"type":"string","minLength":1}
      }
    },
    "review": {
      "type":"object","additionalProperties":false,
      "required":["state","reviewer_id"],
      "properties":{
        "state":{"enum":["UNVERIFIED","VERIFIED","REJECTED"]},
        "reviewer_id":{"type":["string","null"],"minLength":1}
      },
      "allOf":[{"if":{"properties":{"state":{"const":"VERIFIED"}}},"then":{"properties":{"reviewer_id":{"type":"string","minLength":1}}}}]
    },
    "settings": {
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["code","value","unit"],
        "properties":{
          "code":{"type":"string","minLength":1},
          "value":{"type":["number","string"]},
          "unit":{"type":["string","null"],"minLength":1}
        },
        "allOf":[{"if":{"properties":{"value":{"type":"number"}}},"then":{"properties":{"unit":{"type":"string","minLength":1}}}}]
      }
    }
  }
}
