      "profiles": [
        {
          "id": "M14-NOTIFICATION-DOMAIN-EVENTS",
          "owner": "CAP-NOTIFICATIONS",
          "source_ids": [
            107,
            118,
            342,
            367,
            756,
            1025,
            4305
          ],
          "variants": [
            {
              "source_id": 107,
              "purpose": "Deliver cross-domain reminders through push, SMS and email.",
              "difference": "Adds the explicit cross-domain medicine, appointment, vaccination, laboratory, travel and AI recommendation routing matrix to the existing channel/template lifecycle.",
              "dependency": [
                "CAP-MEDICATION",
                "CAP-APPOINTMENTS",
                "CAP-IMMUNIZATION",
                "CAP-LABORATORY",
                "CAP-TRAVEL",
                "CAP-AI"
              ]
            },
            {
              "source_id": 118,
              "purpose": "Present a unified notification inbox for medical, access, AI and emergency events.",
              "difference": "Preserves QR access, AI alerts and emergency events as separate origin categories. An inbox read state is not human clinical acknowledgement.",
              "dependency": [
                "CAP-QR",
                "CAP-AI",
                "CAP-EMERGENCY"
              ]
            },
            {
              "source_id": 342,
              "purpose": "Notify authorized recipients of device and synchronization events.",
              "difference": "Preserves low battery, offline, synchronization failure, firmware update and new-measurement events. The device owner determines state; notification never performs a firmware or therapy change.",
              "dependency": [
                "CAP-DEVICES"
              ]
            },
            {
              "source_id": 367,
              "purpose": "Notify recipients of laboratory workflow milestones and critical-result events.",
              "difference": "Preserves sample received, analysis started, results available and critical result separately. Laboratory authority determines criticality; delivery alone cannot close critical-result escalation.",
              "dependency": [
                "CAP-LABORATORY"
              ]
            },
            {
              "source_id": 756,
              "purpose": "Deliver pregnancy-context appointment, laboratory, ultrasound and medication reminders.",
              "difference": "Preserves the four distinct event sources; a pregnancy profile does not duplicate the shared notification lifecycle. Confidential content must be redacted in external previews.",
              "dependency": [
                "CAP-APPOINTMENTS",
                "CAP-LABORATORY",
                "CAP-IMAGING",
                "CAP-MEDICATION"
              ]
            },
            {
              "source_id": 1025,
              "purpose": "Deliver pediatric infection laboratory, medication, isolation and follow-up notifications.",
              "difference": "Preserves isolation completion as an externally authorized event, not a timer-derived clearance. Guardian authority and confidential child/adolescent context are checked for each recipient.",
              "dependency": [
                "CAP-LABORATORY",
                "CAP-MEDICATION",
                "CAP-SPECIALTY",
                "CAP-APPOINTMENTS"
              ]
            },
            {
              "source_id": 4305,
              "purpose": "Deliver versioned vaccination-status notifications with jurisdiction and preference context.",
              "difference": "Preserves upcoming, due soon, due, window ending, overdue, catch-up required and medical review required separately. Immunization/CDS owns those determinations; delivery configuration cannot override clinical windows or invent catch-up rules.",
              "dependency": [
                "CAP-IMMUNIZATION",
                "CAP-CDS"
              ]
            }
          ]
        }
      ],
      "semantic_decision": "M14-NOTIFICATION-DOMAIN-EVENTS",
      "owner_evidence": "One existing delivery owner with event-origin variants. No new canonical module; seven source profiles extend the shared notification capability. Origin services determine clinical/event truth. Notifications owns authorized template rendering, recipient/channel selection, scheduling, attempts and delivery records. Clinical response and acknowledgement remain separate.",
      "document": "docs/canonical/master14/CAP-NOTIFICATIONS.md",
      "extends_document": "docs/canonical/master08/CAP-NOTIFICATIONS.md",
      "also_extends_document": "docs/canonical/master12/CAP-NOTIFICATIONS.md",
